{
  "name": "oyna-ui",
  "version": "0.1.1",
  "description": "Oyna UI — a Vue 3 component library with a dark glass look",
  "keywords": [
    "component-library",
    "components",
    "dark",
    "design-system",
    "glass",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://oyna-ui.org",
  "bugs": "https://github.com/azabroflovski/oyna-ui/issues",
  "license": "MIT",
  "author": "azabroflovski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azabroflovski/oyna-ui.git"
  },
  "files": [
    "dist",
    "fonts.css",
    "tailwind.css",
    "unocss.js",
    "unocss.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./fonts.css": "./fonts.css",
    "./tailwind.css": "./tailwind.css",
    "./unocss": {
      "types": "./unocss.d.ts",
      "import": "./unocss.js"
    }
  },
  "scripts": {
    "dev": "bun --bun vite playground",
    "build": "bun --bun vite build",
    "prepack": "bun run build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun --bun vitest run",
    "docs:dev": "bun --bun vitepress dev docs",
    "docs:build": "bun --bun vitepress build docs"
  },
  "dependencies": {
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@lucide/vue": "^1.49.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "~6.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
