{
  "name": "oyna",
  "type": "module",
  "version": "0.1.0",
  "description": "Oyna UI — a Vue 3 component library with a dark glass look",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "component-library",
    "design-system",
    "dark",
    "glass"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --bun vite playground",
    "build": "bun --bun vite build",
    "prepack": "bun run build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "test": "bun --bun vitest run",
    "docs:dev": "bun --bun vitepress dev docs",
    "docs:build": "bun --bun vitepress build docs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
